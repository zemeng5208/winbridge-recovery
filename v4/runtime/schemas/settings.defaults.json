  "theme": "system",
  "reduceMotion": false,
  "progressColors": ["#4A6CF7", "#8B5CF6", "#22C7A9"],
  "diagnosticConcurrency": 2,
  "logBatchSize": 64,
  "logMemoryLimitBytes": 1048576,
